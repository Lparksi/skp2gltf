FROM debian:bookworm-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/


ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    WINEARCH=win64 \
    WINEDEBUG=-all \
    WINEDLLOVERRIDES=mscoree,mshtml= \
    WINEPREFIX=/root/.wine \
    PATH="/app/.venv/bin:$PATH"

# Install base dependencies (ARM64 specific)
# Native ARM64 libs are needed by Box64 for Wine performance and functionality
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        gnupg2 \
        xvfb \
        xz-utils \
        # Native ARM64 libraries for Box64+Wine
        libfontconfig1 \
        libfreetype6 \
        libx11-6 \
        libxext6 \
        libxrender1 \
        libxrandr2 \
        libxcursor1 \
        libxi6 \
        libxfixes3 \
        libxcomposite1 \
        libglib2.0-0 \
        libpng16-16 \
        libjpeg62-turbo \
        libxml2 \
        libxslt1.1 \
        libmpg123-0 \
        libasound2 \
        libpulse0 \
        libgnutls30 \
        libgl1 \
        libglu1-mesa \
        python3 \
    && rm -rf /var/lib/apt/lists/*


# Setup Box64 + Kron4ek Wine (optimized for ARM64)
RUN wget -qO- https://pi-apps-coders.github.io/box64-debs/KEY.gpg | gpg --dearmor -o /usr/share/keyrings/box64-archive-keyring.gpg && \
    printf "Types: deb\nURIs: https://Pi-Apps-Coders.github.io/box64-debs/debian\nSuites: ./\nSigned-By: /usr/share/keyrings/box64-archive-keyring.gpg\n" > /etc/apt/sources.list.d/box64.sources && \
    apt-get update && apt-get install -y --no-install-recommends box64-generic-arm && \
    mkdir -p /opt/wine-stable && \
    curl -SL https://github.com/Kron4ek/Wine-Builds/releases/download/9.0/wine-9.0-amd64.tar.xz | tar -xJ -C /opt/wine-stable --strip-components=1 && \
    # Prune 32-bit (x86) support - skp2gltf is native 64-bit
    rm -rf /opt/wine-stable/lib/wine/i386-windows /opt/wine-stable/lib/wine/i386-unix /opt/wine-stable/lib32 && \
    # Remove documentation to save space
    rm -rf /opt/wine-stable/share/doc /opt/wine-stable/share/man && \
    ln -s /opt/wine-stable/bin/wine64 /usr/local/bin/wine64 && \
    ln -s /opt/wine-stable/bin/wine /usr/local/bin/wine && \
    rm -rf /var/lib/apt/lists/*

# Pre-initialize Win64 prefix using Box64
RUN Xvfb :99 -screen 0 1024x768x24 & \
    PID=$! && \
    sleep 5 && \
    box64 wine64 wineboot --init && \
    # Cleanup prefix boilerplate
    rm -rf /root/.wine/drive_c/users/root/AppData/Local/Package\ Cache && \
    wineserver -w && \
    kill $PID || true

WORKDIR /app

# Copy Windows build artifacts and API source
COPY docker-bin/ /app/
COPY api.py pyproject.toml /app/
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

RUN uv sync --no-dev --no-install-project && \
    # Cleanup cache
    rm -rf /root/.cache/uv

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["--service"]

